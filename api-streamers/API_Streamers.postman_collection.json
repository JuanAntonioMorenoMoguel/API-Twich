  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"email\": \"juan@correo.com\",\n  \"edad\": 24\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set(\"usuario_id\", pm.response.json().id);",
                  "pm.test(\"Incluye enlaces\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"enlaces\");",
                  "});"
                ]
              }
            }
          ]
        },
